#!/usr/bin/env bash
#
# Run markdown linting locally
set -e

# The files markdownlint-cli2 is pointed at. This fork has no markdown job in
# CI (upstream drives the same list from .github/workflows/build.yml, which this
# fork does not have), so this list is the only copy here.
globs="
CONTRIBUTING.md
MAINTAINERS.md
README.md
RELEASE.md
CODE_OF_CONDUCT.md
librclone/README.md
backend/s3/README.md
docs/content/{_index,authors,bugs,changelog,docs,downloads,faq,filtering,gui,install,licence,overview,privacy}.md
"

docker run --rm -v $PWD:/workdir --user $(id -u):$(id -g) davidanson/markdownlint-cli2 $globs
