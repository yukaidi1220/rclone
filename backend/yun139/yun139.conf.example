# =============================================================================
# 中国移动云盘 (China Mobile Cloud Drive, 139) - rclone backend config sample
# =============================================================================
# 放置位置: ~/.config/rclone/rclone.conf (Linux/macOS) 或
#           %APPDATA%\rclone\rclone.conf (Windows)
# 或通过 --config 指定任意路径的 conf 文件。
#
# 每个 remote 一节, [remote名] 后跟 key = value。两个 remote 可共存:
# 同一个账号可以同时添加个人云和家庭云 (space 不同即可)。
#
# 所有参数一览 (共 9 个):
#   authorization       (必填, 敏感) 授权 token
#   space               (必填) 空间类型: personal | family
#   family_id           (family 必填) 家庭云 ID
#   root_folder_id      (可选) 根文件夹 ID
#   user_domain_id      (可选) 用户域 ID
#   hard_delete         (可选, 默认 false) 永久删除
#   part_size           (可选, 默认 5Mi) 分片大小
#   upload_concurrency  (可选, 默认 4) 分片并发数
#   encoding            (可选, 默认 Standard|InvalidUtf8|LeftSpace|LeftTilde|...)
#                       文件名编码
# =============================================================================

# -----------------------------------------------------------------------------
# 示例 1: 个人云 (最简配置, 推荐作为起点)
# -----------------------------------------------------------------------------
[yun139-personal]
type = yun139
authorization = <在此粘贴 base64("pc:<账号>:<token>")>   # 必填, 敏感字段
space = personal

# -----------------------------------------------------------------------------
# 示例 2: 家庭云 (family 必填 family_id; 其余与个人云相同)
# -----------------------------------------------------------------------------
[yun139-family]
type = yun139
authorization = <同上, 同账号可复用同一 token>
space = family
family_id = <家庭云 ID, 数字; 多家庭时必填, 见下方说明>

# =============================================================================
# 参数详解
# =============================================================================

# --- authorization (必填, 敏感) ---------------------------------------------
# 格式: base64("pc:<账号>:<token>|...")。token 及其余部分从登录态获取。
# 获取方式 (任选):
#   1) OpenList/alist 的 139 存储配置里已有 authorization 值, 直接复制;
#   2) 浏览器登录 https://yun.139.com 后, DevTools 抓任意 API 请求的
#      Authorization 请求头 (完整 base64 串);
#   3) 官方 PC 客户端抓包同样可得 (抓 Authorization 头即可)。
# 注意:
#   - token 有效期约 15 天 (官方客户端行为)。过期后 rclone 会自动调用
#     SSO heartbeat 接口续期 (无需手动更换), 但 config 文件里的值不会变。
#   - 该字段是敏感的: 请勿提交到 git / 分享 conf 文件。
#   - 个人云与家庭云同账号可复用同一个 authorization。

# --- space (必填) ------------------------------------------------------------
# 使用哪个存储空间。
#   personal = 新个人云 (默认, 不写即个人云)
#   family   = 新家庭云
# 同账号两个空间可各自建 remote, 互不影响。

# --- family_id (family 必填) -------------------------------------------------
# 家庭云 ID (纯数字, 形如 1303251918616070593)。
# 规则:
#   - space = family 且只有一个家庭时, 可留空, 启动时自动发现;
#   - 有多个家庭时, 必须显式指定, 否则启动报错并列出所有家庭 ID 供选择;
#   - ID 从官方客户端请求 URL 的 u= 参数或 queryFamilyCloud 响应获得。
# 注意: 家庭名可重复 (例如两个都叫"我的家庭"), 只有 ID 是唯一的,
#       因此这里只接受 ID, 不接受名字或序号。

# --- root_folder_id (可选, 高级) --------------------------------------------
# 指定后, 该 remote 的根目录为对应 ID 的文件夹 (仅限该文件夹内操作)。
# 留空 = 使用云盘顶级目录。
# 注意: 该字段是敏感的 (含路径信息), 但可留空; 通常无需设置。

# --- user_domain_id (可选, 高级) --------------------------------------------
# 用户域 ID (形如 1301956522699563527)。
# 来源: 官方客户端请求 URL 的 'u=' 参数, 或 user/getUser /
#       queryFamilyCloud 响应。
# 留空时后端会自动从 queryFamilyCloud 发现; 仅在自动发现失败时手动设置。
# 注意: 个人云部分接口可接受手机号代替, 但 batchCopy/配额等接口需要它。

# --- hard_delete (可选, 高级, 默认 false) -----------------------------------
# true  = 删除文件直接永久删除, 不进回收站;
# false = 删除进回收站 (个人云默认)。
# 仅对个人云生效; 家庭云删除总是直接删除。
# 注意: 139 的 API 不支持列出回收站或恢复文件, 误删后无法通过 rclone 找回。

# --- part_size (可选, 高级, 默认 5Mi) ---------------------------------------
# 大于此大小的文件按分片上传, 每片此大小。
# 约束:
#   - 最小 5Mi (服务端拒绝更小分片, 实测 1/2/4Mi 均报 04000002);
#   - 必须是 64 的倍数;
#   - 官方客户端默认 100Mi; 增大可减少分片数量 (大文件更稳),
#     减小可降低单次请求内存占用。
# 例: part_size = 100Mi

# --- upload_concurrency (可选, 高级, 默认 4) --------------------------------
# 单个文件内分片并发上传数。默认 4。
# 增大可提高大文件上传速度 (但受带宽/服务端限制);
# 减小可在弱网下更稳。

# --- encoding (可选, 高级, 默认见下) ----------------------------------------
# 文件名编码规则 (rclone encoder 位掩码, 逗号分隔)。
# 默认值已覆盖 139 服务端拒绝的字符 (首尾空格/波浪线/控制字符/非法 UTF-8):
#   encoding = Standard,InvalidUtf8,LeftSpace,LeftTilde,LeftCrLfHtVt,RightSpace
# 一般无需修改; 只有在与其它工具互通遇到文件名转义问题时才调整。

# =============================================================================
# 使用示例
# =============================================================================
#   # 列出个人云根目录
#   rclone lsf yun139-personal:
#   # 上传
#   rclone copy /path/to/file yun139-personal:文件夹/
#   # 下载
#   rclone copy yun139-personal:文件夹/ /path/to/local/
#   # 家庭云
#   rclone lsf yun139-family:
#   # 校验 (个人云支持 SHA-256, rclone check 可用; 家庭云无 hash, 退化为大小+时间)
#   rclone check /path/to/local yun139-personal:
#
# 已知限制 (详见 docs/content/yun139.md):
#   - 上传后服务端强制使用服务器时间作为修改时间, 无法 SetModTime;
#   - 家庭云无原生 move, move 退化为 copy+delete;
#   - 服务器文件名大小写不敏感;
#   - part_size 必须 >= 5Mi 且为 64 的倍数。